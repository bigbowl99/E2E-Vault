{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E2E-Vault",
  "version": "0.1.0",
  "identifier": "com.cryptim.e2evault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "E2E-Vault - Secure Desktop IM Assistant",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["e2e"],
        "name": "E2E Encrypted Vault File",
        "description": "E2E Encrypted Vault File for Secure IM Transfer",
        "role": "Viewer"
      }
    ]
  }
}
